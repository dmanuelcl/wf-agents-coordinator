[Unit]
Description=Agent Coordinator remote runner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Copy this file into ~/.config/systemd/user/ and adjust every absolute path.
# Use node directly: a user service does not load nvm, and pnpm's shebang uses
# /usr/bin/env node, which would otherwise fail before the runner starts.
WorkingDirectory=/srv/agent-coordinator/app
EnvironmentFile=/srv/agent-coordinator/runner.env
ExecStart=/usr/bin/node /srv/agent-coordinator/app/out/main/remote-runner.js
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=45

[Install]
WantedBy=default.target
