[Unit]
Description=Agent Coordinator remote runner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Copy this file into ~/.config/systemd/user/ and adjust every absolute path.
# ExecStart runs scripts/run-remote-runner.sh rather than node or pnpm: a user
# service loads neither nvm nor your shell profile, and the runner must use the
# exact Node pinned in .nvmrc (the one that built the native addons). The script
# resolves that version itself, so this file never names it and cannot drift.
WorkingDirectory=/srv/agent-coordinator/app
EnvironmentFile=/srv/agent-coordinator/runner.env
ExecStart=/srv/agent-coordinator/app/scripts/run-remote-runner.sh
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=45

[Install]
WantedBy=default.target
